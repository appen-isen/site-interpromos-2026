{
  "name": "site-interpromos-2026",
  "version": "1.0.0",
  "description": "Site et API du tournoi Interpromos (ISEN Nantes)",
  "license": "ISC",
  "author": "AppenISEN",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "dev": "node --watch index.js",
    "start": "node index.js",
    "check": "npm run check:syntax && npm run check:openapi",
    "check:syntax": "node scripts/check-syntax.js",
    "check:openapi": "node scripts/check-openapi.js",
    "check:connections": "node scripts/check-connections.js",
    "db:migrate": "node scripts/migrate.js",
    "db:migrate:prod": "node --env-file=.env.production scripts/migrate.js --production",
    "db:clean": "node scripts/clean-db.js",
    "db:role": "node scripts/set-db-role.js",
    "db:role:prod": "node --env-file=.env.production scripts/set-db-role.js",
    "admin:grant": "node scripts/grant-admin.js",
    "admin:grant:prod": "node --env-file=.env.production scripts/grant-admin.js",
    "admin:list": "node scripts/grant-admin.js --list",
    "admin:list:prod": "node --env-file=.env.production scripts/grant-admin.js --list"
  },
  "dependencies": {
    "express": "^5.3.0",
    "jose": "^6.2.14",
    "pg": "^8.13.3"
  },
  "engines": {
    "node": ">=20.6"
  },
  "devDependencies": {
    "yaml": "^2.9.1"
  }
}
